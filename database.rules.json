{
  "rules": {
    "parties": {
      ".read": false,
      ".write": false,
      "$party": {
        ".read": "$party.matches(/^[a-z0-9-]{12,40}$/)",
        "meta": {
          ".write": "$party.matches(/^[a-z0-9-]{12,40}$/)",
          ".validate": "newData.hasChildren(['title', 'uid'])",
          "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "details": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "uid": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "items": {
          "$id": {
            ".write": "$party.matches(/^[a-z0-9-]{12,40}$/)",
            ".validate": "newData.hasChildren(['name', 'category', 'by', 'uid'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "category": { ".validate": "newData.isString() && newData.val().matches(/^(sauce|cheese|topping|other)$/)" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "uid": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "pizzas": {
          "$id": {
            ".write": "$party.matches(/^[a-z0-9-]{12,40}$/)",
            ".validate": "newData.hasChildren(['name', 'by', 'uid'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "uid": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "ingredients": { "$i": { ".validate": "newData.isString() && newData.val().length <= 40" } },
            "votes": { "$voter": { ".validate": "newData.isString() && newData.val().length <= 40" } },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
